<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Tenant">
            <directory>tests/Tenant</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:0oErKnFKzAbeLxI4ZJlz/+SjtNUgaEo5OCJx251zLmk="/>
        <!-- Override superadmin credentials to test-specific values, regardless of .env -->
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="TENANT_BASE_DOMAIN" value="lvh.me" force="true"/>
        <env name="SUPERADMIN_EMAIL" value="ci-admin@sims.test" force="true"/>
        <env name="SUPERADMIN_PASSWORD" value="ci-secret-123" force="true"/>
        <!-- PostgreSQL connection (falls back to .env if already set in the environment) -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="postgres"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="sims"/>
        <env name="DB_USERNAME" value="sims_user"/>
        <env name="DB_PASSWORD" value="sims_password"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
