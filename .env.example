CERT_EMAIL=admin@example.com
SSL_DNS_SCRIPT_PATH=scripts/namecom_certbot_dns01.py
API_USER=
API_TOKEN=
CERTBOT_BIN=certbot
CERTBOT_CONFIG_DIR=/etc/letsencrypt
CERTBOT_WORK_DIR=/var/lib/letsencrypt
