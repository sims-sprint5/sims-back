DNS_PROPAGATION_TIMEOUT=180
DNS_PROPAGATION_INTERVAL=15
DNS_PROPAGATION_INITIAL_WAIT=20
DNS_TTL=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
