SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.lvh.me
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_PATTERNS=

